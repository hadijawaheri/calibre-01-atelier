NODE_ENV=development
PORT=7781
HOST=127.0.0.1
# A replica set, as in production, so multi-document transactions work when a feature needs them
DATABASE_URL=mongodb://127.0.0.1:27018/kronos?replicaSet=rs0

# generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
OTP_HMAC_SECRET=

CORS_ORIGINS=http://localhost:7782

# console prints the OTP in dev; forbidden in production.
# disabled: production without an SMS vendor yet; the site works and sign-in answers 503
SMS_PROVIDER=console
OTP_FIXED_CODE=
THROTTLE_ENABLED=true
# Same value as API_PROXY_SECRET on the web app (openssl rand -base64 48). Without it every visitor
# behind Vercel shares one rate limit; with it the API trusts the web app's x-client-ip header
API_PROXY_SECRET=

# pnpm seed promotes this mobile to admin
SEED_ADMIN_MOBILE=
