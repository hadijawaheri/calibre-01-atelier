NODE_ENV=development
PORT=7781
HOST=127.0.0.1
# A replica set is required: orders reserve stock inside transactions
DATABASE_URL=mongodb://127.0.0.1:27018/kronos?replicaSet=rs0

# generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
OTP_HMAC_SECRET=

CORS_ORIGINS=http://localhost:7782
PUBLIC_WEB_URL=http://localhost:7782

# console prints the OTP in dev; forbidden in production
SMS_PROVIDER=console
OTP_FIXED_CODE=
# fake opens a sandbox gateway page; forbidden in production
PAYMENT_PROVIDER=fake
THROTTLE_ENABLED=true

# pnpm seed promotes this mobile to admin
SEED_ADMIN_MOBILE=
