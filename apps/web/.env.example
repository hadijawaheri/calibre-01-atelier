# server-side only: where Next rewrites /api/* and where Server Components fetch
INTERNAL_API_URL=http://localhost:7781
# Same value as API_PROXY_SECRET in the API's .env. With it the API rate-limits each visitor on their
# own address instead of Vercel's. Read at runtime; never exposed to the browser.
API_PROXY_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:7782
