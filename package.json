{
  "name": "kronos",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @kronos/contracts build && pnpm -r --parallel dev",
    "build": "pnpm --filter @kronos/contracts build && pnpm -r --filter \"!@kronos/contracts\" build",
    "typecheck": "pnpm --filter @kronos/contracts build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @kronos/contracts build && pnpm -r test",
    "format": "prettier --write .",
    "seed": "pnpm --filter @kronos/contracts build && pnpm --filter @kronos/api seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
